    },
    {
      "id": "hd-20261011-001500-606a90a2e3b1/candidates/0/1/claim/33",
      "candidate_id": "hd-20261011-001500-606a90a2e3b1/candidates/0/1",
      "kind": "ASSUMPTION",
      "text": "L4 and L3 assume the controller can read GitHub PR checks and clone from GitHub. The 22:30 entry shows a fresh GitHub clone and CI inspection already happened, so no new permission appears to be needed.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261011-001500-606a90a2e3b1/candidates/0/1/claim/34",
      "candidate_id": "hd-20261011-001500-606a90a2e3b1/candidates/0/1",
      "kind": "ASSUMPTION",
      "text": "L5 (screenshots at each viewport) is justified by the 21:40 entry, where readability defects that tests missed were found: interval fragmentation, -0.00 Brier differences, and squeezed headers at 375 px.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261011-001500-606a90a2e3b1/candidates/0/1/claim/35",
      "candidate_id": "hd-20261011-001500-606a90a2e3b1/candidates/0/1",
      "kind": "ASSUMPTION",
      "text": "L5 says \"before accepting\", but in 21:40 the screenshots were taken after Howl acceptance, from the clean clone, during final assessment. \"Accepting\" is ambiguous between the Howl acceptance and the controller's run-level acceptance. As written, a finding does not block anything because it may be \"listed as open\", so the lesson is a recording duty and not a gate.",
      "status": "UNVERIFIED",
