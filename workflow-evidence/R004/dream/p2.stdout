      "kind": "ASSUMPTION",
      "text": "Lesson 5 (screenshots) is justified by the 21:40 entry, where the screenshots exposed defects that no test caught.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
