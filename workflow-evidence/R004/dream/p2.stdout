      "candidate_id": "hd-20261011-001500-606a90a2e3b1/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Lesson 3 does not address separate repair PRs, such as the howlplane repair worktree PR, so it is unclear whether \"per repository per run\" covers them.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
