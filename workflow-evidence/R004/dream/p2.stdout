    {
      "id": "hd-20261011-001500-606a90a2e3b1/baseline/0/0/claim/29",
      "candidate_id": "hd-20261011-001500-606a90a2e3b1/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "\"Or record it in the PR with a reason\" lets a failing check be handed off with only a note, which could be read as weakening the merge gate. It also does not cover pending or absent CI.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261011-001500-606a90a2e3b1/baseline/0/0/claim/30",
      "candidate_id": "hd-20261011-001500-606a90a2e3b1/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Lesson 4 does not say whether a Howl fix for a CI failure counts against the session budget. The journal treated one as a repair, \"not a product session\". This is ambiguous, and a reader could infer new spending or exemption.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261011-001500-606a90a2e3b1/baseline/0/0/claim/31",
      "candidate_id": "hd-20261011-001500-606a90a2e3b1/baseline/0/0",
      "kind": "IDEA",
      "text": "Lesson 4 wording fix: \"A failing check is a finding: fix it through Howl within existing session and request budgets, or pause under section 17. Hand off with an unresolved failing check only if the PR body states the failure and that the PR is not ready to merge. If checks are pending or absent, record that state.\"",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
