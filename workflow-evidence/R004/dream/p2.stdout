      "id": "hd-20261011-001500-606a90a2e3b1/baseline/0/0/claim/27",
      "candidate_id": "hd-20261011-001500-606a90a2e3b1/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Lesson 4 (read CI before handoff) is clearly justified by the #168 CI failure that local gates and Howl review missed.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261011-001500-606a90a2e3b1/baseline/0/0/claim/28",
      "candidate_id": "hd-20261011-001500-606a90a2e3b1/baseline/0/0",
