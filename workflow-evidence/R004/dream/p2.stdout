      "id": "hd-20261011-001500-606a90a2e3b1/baseline/0/0/claim/24",
      "candidate_id": "hd-20261011-001500-606a90a2e3b1/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Lesson 3 has a recovery gap. It does not say what to do when a stacked PR has already been merged into a non-default branch, as happened with #12 to #14. Such a merge should not count as MERGED or MERGED_VERIFIED.",
      "status": "UNVERIFIED",
