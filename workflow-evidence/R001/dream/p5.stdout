        },
        {
          "id": "hd-20261009-131111-e450e5bb5261/candidates/0/0/claim/28",
          "candidate_id": "hd-20261009-131111-e450e5bb5261/candidates/0/0",
          "kind": "IDEA",
          "text": "Stratify the pool before ranking (prior MLB time vs. none, pitcher vs. hitter), evaluate top-k within the no-MLB stratum, and use a rate-based or above-replacement outcome alongside the playing-time threshold.",
          "status": "UNVERIFIED",
          "extractor": "line_grammar/v1"
        },
        {
          "id": "hd-20261009-131111-e450e5bb5261/candidates/0/0/claim/29",
          "candidate_id": "hd-20261009-131111-e450e5bb5261/candidates/0/0",
          "kind": "IDEA",
          "text": "Add stronger baselines: B0+B1 combined, last-year-stats-only logistic, and a public projection system, plus a \"tops by age only\" null. Report an opportunity-adjusted outcome that conditions on the signing club's roster openings where public.",
