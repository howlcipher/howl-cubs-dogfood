        {
          "id": "hd-20261008-143634-565a00716635/candidates/0/2/claim/35",
          "candidate_id": "hd-20261008-143634-565a00716635/candidates/0/2",
          "kind": "ASSUMPTION",
          "text": "Shared-blind-spot: backtests are proxies for the metric, not for decisions. None defines the counterfactual, the cost of a wrong alert, or a win-value estimate. Small samples, multiple comparisons and retrospective tuning threaten all of them.",
          "status": "UNVERIFIED",
