          "candidate_id": "hd-20261009-212841-eccdc1b3971d/candidates/0/2",
          "kind": "ASSUMPTION",
          "text": "Workload is a meaningful driver of injury compared with unobserved biomechanics. If not, the intervention has a low ceiling, similar to the R001 result.",
          "status": "UNVERIFIED",
          "extractor": "line_grammar/v1"
        },
        {
          "id": "hd-20261009-212841-eccdc1b3971d/candidates/0/2/claim/16",
