    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/2/claim/18",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/2",
      "kind": "ASSUMPTION",
      "text": "A send model needs the ball position at the moment of the decision, which public tracking may not expose at enough granularity.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/2/claim/19",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/2",
      "kind": "ASSUMPTION",
      "text": "Criterion (b) holds well for this family, but third-base send decisions are made in real time with no time for a tool, so the value would come from pre-game coach training and thresholds.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/2/claim/20",
