        },
        {
          "id": "hd-20261009-212841-eccdc1b3971d/candidates/0/2/claim/13",
          "candidate_id": "hd-20261009-212841-eccdc1b3971d/candidates/0/2",
          "kind": "IDEA",
          "text": "Problem: year-over-year workload progression for minor-league pitchers. Owner: the pitching coordinator and medical staff. Decision: each pitcher's innings or pitch-count ceiling and in-season pacing, set for every pitcher in an organization each year. Cases: thousands of pitcher-seasons league-wide with public innings, appearance and pitch-count logs. Observable outcome: publicly reported injured-list placements and next-season availability. Baseline: a fixed percentage increase over the prior season's innings. Intervention: a pacing rule that also uses public signals such as velocity trends, pitches per inning, and short-rest appearances.",
          "status": "UNVERIFIED",
          "extractor": "line_grammar/v1"
        },
        {
          "id": "hd-20261009-212841-eccdc1b3971d/candidates/0/2/claim/14",
          "candidate_id": "hd-20261009-212841-eccdc1b3971d/candidates/0/2",
          "kind": "ASSUMPTION",
          "text": "Public injured-list records for minor-league pitchers capture injuries reliably. Underreporting would break (b).",
          "status": "UNVERIFIED",
          "extractor": "line_grammar/v1"
        },
        {
