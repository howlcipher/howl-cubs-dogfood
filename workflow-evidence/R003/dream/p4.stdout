  "claims": [
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/1",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "IDEA",
      "text": "Third-base coach send/hold. Owner: third-base coach and baserunning coordinator. Decision: send or hold a runner on a ball in play to the outfield, several times per game. Cases: every send/hold opportunity league-wide each season, reconstructable from public play-by-play and tracking-derived runner and fielder data. Outcome: runner safe, out, or held, plus the run expectancy that follows. Baseline: hold or send based on outs, score and the coach's read of the arm. Intervention: a pre-game card of break-even send probabilities by outs, base state, fielder arm and runner sprint speed, then a retrospective comparison of actual sends against that threshold.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/2",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Public tracking data captures fielder position, arm strength and runner speed well enough to estimate safe probability at the moment the coach decides.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/3",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "The coach's real-time read adds information that a retrospective model cannot see, which could bias any measured gap toward the tool.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/4",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Criterion (c) may fail because per-decision run value is small, so the season total depends on how far the club's current sends are from break-even.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/5",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "UNKNOWN",
      "text": "cubs_current_send_hold_policy",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/6",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "UNKNOWN",
      "text": "public_data_availability_for_ball_retrieval_timing",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/7",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "IDEA",
      "text": "Stolen-base and pickoff-limit exploitation. Owner: first-base coach, manager, baserunning staff. Decision: attempt or decline a steal, especially after the pitcher has used disengagements, many times per series. Cases: every runner-on-first or runner-on-second state league-wide, logged in public play-by-play along with disengagement counts under current rules. Outcome: stolen base, caught stealing, pickoff, and the resulting run expectancy. Baseline: green light for fast runners, conservative for others. Intervention: a per-pitcher, per-catcher break-even model using public pop time, pitcher time to plate, disengagements remaining and runner speed.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/8",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Rule changes in recent seasons limit how many seasons are comparable, which reduces (a).",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/9",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Opponents adapt once a club's aggressiveness becomes visible, so gains may decay. This is a counterparty effect.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/10",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "UNKNOWN",
      "text": "public_time_to_plate_measurement_reliability",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/11",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "UNKNOWN",
      "text": "cubs_baserunning_green_light_rules",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/12",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "IDEA",
      "text": "Starting pitcher removal timing. Owner: manager and pitching coach. Decision: remove or keep the starter at each batter from the middle innings onward, every game. Cases: every batter faced in the later innings of every start league-wide each season, with pitch count, times through the order and pitch-quality signals from public tracking. Outcome: run value of the next batters versus the replacement reliever's run value. Baseline: pitch-count threshold plus third-time-through heuristics. Intervention: a within-game fatigue and quality signal from velocity, spin and command drift compared with the specific available reliever.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/13",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Bullpen workload across the following days is part of the true cost and is hard to price in a retrospective test.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/14",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Selection bias exists because starters who stay in were judged to be pitching well, so naive comparisons will mislead without careful causal design.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/15",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "This overlaps with the explored family of opposing bullpen availability only in data, not in the decision owner.",
