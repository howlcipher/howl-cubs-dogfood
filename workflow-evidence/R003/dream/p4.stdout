    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/46",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "IDEA",
      "text": "Starter-to-reliever conversion in development. Owner: pitching development staff. Decision: keep a pitching prospect starting or convert to relief, many decisions per year league-wide. Cases: every role switch visible in public minor-league usage logs across systems. Outcome: subsequent velocity, strikeout and walk rates, innings, and MLB contribution. Baseline: convert when command or third-pitch development stalls by a certain age. Intervention: a model using repertoire depth and times-through-the-order decay from public pitch data.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/47",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Injury history drives many conversions and is not fully public, which weakens (d).",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/48",
