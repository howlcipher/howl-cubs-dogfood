    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/18",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "IDEA",
      "text": "High-leverage reliever assignment. Owner: manager and bullpen coach. Decision: which available reliever enters which inning and leverage state, most games. Cases: every reliever entry league-wide each season, with public leverage index and matchup handedness. Outcome: run value and win-probability change over the reliever's batters. Baseline: fixed roles such as closer in the ninth with a save situation and setup in the eighth. Intervention: assign the best available arm to the highest expected-leverage spot by projected upcoming hitters, subject to rest constraints.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/19",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Pitcher comfort with roles affects performance and is not publicly observable, which weakens (d).",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/20",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Three-batter-minimum rules constrain the decision space and must be encoded correctly.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/21",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "UNKNOWN",
