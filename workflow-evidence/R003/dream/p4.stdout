    },
    {
      "id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0/claim/17",
      "candidate_id": "hd-20261009-212841-eccdc1b3971d/baseline/0/0",
      "kind": "UNKNOWN",
      "text": "counterfactual_reliever_performance_estimate_method",
      "status": "UNVERIFIED",
