          "candidate_id": "hd-20261009-212841-eccdc1b3971d/candidates/0/2",
          "kind": "ASSUMPTION",
          "text": "Rest decisions are largely driven by matchups and minor injuries that are not public. This confounds a retrospective test and hurts (b).",
          "status": "UNVERIFIED",
          "extractor": "line_grammar/v1"
        },
        {
          "id": "hd-20261009-212841-eccdc1b3971d/candidates/0/2/claim/35",
