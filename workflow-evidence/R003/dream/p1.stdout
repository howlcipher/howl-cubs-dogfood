      "candidate_id": "hd-20261009-211812-efe1740f0c77/candidates/0/3",
      "kind": "IDEA",
      "text": "Problem=spring-training signal underuse; owner=GM and manager; decision=final Opening Day roster spots and early-season role assignments each late March; value=a few marginal roster slots and leverage roles over the first weeks; mechanism=spring Statcast-tracked velocity, spin and exit-velocity changes may carry real signal even though spring outcome stats are noise; baseline=ignore spring stats and rely on prior-season performance plus contract status; intervention=a model that combines spring physical-tracking deltas with prior-season projections, backtested on public spring tracking against regular-season results.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/candidates/0/3/claim/2",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/candidates/0/3",
      "kind": "ASSUMPTION",
      "text": "Public spring-training tracking data covers enough parks, players and seasons to support a retrospective test.",
      "status": "UNVERIFIED",
