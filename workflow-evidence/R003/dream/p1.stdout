    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/candidates/0/2/claim/20",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/candidates/0/2",
      "kind": "ASSUMPTION",
      "text": "Historical game-delay times and forecasts as issued at the time can be reconstructed from public sources for a retrospective test.",
      "status": "UNVERIFIED",
