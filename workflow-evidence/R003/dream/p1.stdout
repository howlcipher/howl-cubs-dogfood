    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/baseline/0/0/claim/41",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/baseline/0/0",
      "kind": "IDEA",
      "text": "International amateur signings. Owner: international scouting director. Decision: agreements in principle with players years before their signing dates, each January signing period. Value at stake: the international bonus pool. Mechanism: weak, because public information on these players at decision time is sparse. Verdict: public-data software is likely unhelpful, and a retrospective test is hard.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/baseline/0/0/claim/42",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Public data on international amateurs before signing is too thin to beat scouting.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/baseline/0/0/claim/43",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/baseline/0/0",
      "kind": "UNKNOWN",
      "text": "public_international_amateur_data_availability",
