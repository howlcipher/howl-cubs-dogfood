    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/baseline/0/0/claim/32",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/baseline/0/0",
      "kind": "UNKNOWN",
      "text": "public_framing_value_under_challenge_system",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/baseline/0/0/claim/33",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/baseline/0/0",
      "kind": "IDEA",
      "text": "Trade-deadline buy, sell or hold decision. Owner: president of baseball operations and ownership. Decision: the club's deadline posture and how much to spend, in July, every year. Value at stake: prospect capital and the revenue value of playoff odds. Mechanism: estimate how much each added win changes playoff and series-advance probability given the division standings, and compare that with the prospect cost. Baseline: buy if the club is in contention, using public playoff odds. Software: a model of the marginal value of a win, joined to a prospect-cost estimate. Retrospective test: public standings, odds archives and trade records.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/baseline/0/0/claim/34",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Clubs already use playoff-odds tools, so the edge may come mainly from the prospect-cost side rather than from the odds.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/baseline/0/0/claim/35",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/baseline/0/0",
      "kind": "UNKNOWN",
      "text": "playoff_revenue_value_per_round_public_estimate",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/baseline/0/0/claim/36",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/baseline/0/0",
      "kind": "IDEA",
      "text": "In-season waiver and DFA claims. Owner: GM and pro-scouting staff. Decision: whether to claim players within the waiver window during the season. Value at stake: likely low, similar to the minor-league free-agent finding. Mechanism: none clearly beats a prior-MLB-time rule. Baseline: claim players with recent MLB time who fit a roster need. Verdict: software is probably unnecessary here.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/baseline/0/0/claim/37",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "The ceiling on waiver claims resembles the low ceiling found in the earlier minor-league free-agent test. This needs verification.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/baseline/0/0/claim/38",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/baseline/0/0",
      "kind": "IDEA",
      "text": "Ticket pricing and demand forecasting. Owner: business operations. Decision: per-game prices for home games, set all season. Value at stake: ticket revenue. Verdict: clubs and outside vendors are likely already ahead, so a baseball-ops software edge is unlikely.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/baseline/0/0/claim/39",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/baseline/0/0",
      "kind": "ASSUMPTION",
      "text": "Dynamic pricing at the Cubs is already handled by mature systems. This is unverified.",
      "status": "UNVERIFIED",
      "extractor": "line_grammar/v1"
    },
    {
      "id": "hd-20261009-211812-efe1740f0c77/baseline/0/0/claim/40",
      "candidate_id": "hd-20261009-211812-efe1740f0c77/baseline/0/0",
      "kind": "UNKNOWN",
      "text": "cubs_ticket_pricing_system",
      "status": "UNVERIFIED",
